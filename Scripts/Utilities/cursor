#!/usr/bin/env bash
# cursor: launcher + updater for the Cursor AppImage.
#
#   cursor                  launch the latest version (output hidden, detached)
#   cursor -v|--verbose     launch the latest version with full output in terminal
#   cursor -u|--update      download/install the latest version (keeps newest 4)
#   cursor --update --force  re-download even if already up to date
#   cursor --version        list the current version and versions in the Cursor folder
#   cursor --version X.Y.Z  launch a specific installed version
#   cursor -h|--help        show this help
#
# Any other arguments are passed through to the AppImage when launching.
set -euo pipefail

API_URL='https://cursor.com/api/download?platform=linux-x64&releaseTrack=stable'
INSTALL_DIR="${CURSOR_APPIMAGE_DIR:-$HOME/Downloads/Cursor}"
KEEP=4

DO_UPDATE=0
SHOW_VERSION=0
PICK_VERSION=''
FORCE=0
VERBOSE=0
PASSTHRU=()

log() { printf 'cursor: %s\n' "$*" >&2; }
die() { log "error: $*"; exit 1; }

usage() {
  cat <<'EOF'
Usage: cursor [options] [-- args passed to Cursor]

  (no options)        Launch the latest installed version (output hidden)
  -v, --verbose       Launch with full output shown in the terminal
  -u, --update        Download and install the latest version (keeps newest 4)
  -f, --force         With --update: re-download even if up to date
      --version       List current version and versions in the Cursor folder
      --version X.Y.Z Launch a specific installed version
  -h, --help          Show this help

Environment:
  CURSOR_APPIMAGE_DIR   Install directory (default: ~/Downloads/Cursor)
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -u|--update) DO_UPDATE=1; shift ;;
    -f|--force) FORCE=1; shift ;;
    -v|--verbose) VERBOSE=1; shift ;;
    --version)
      SHOW_VERSION=1; shift
      if [[ $# -gt 0 && "$1" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        PICK_VERSION=$1; shift
      fi
      ;;
    -h|--help) usage; exit 0 ;;
    --) shift; PASSTHRU+=("$@"); break ;;
    *) PASSTHRU+=("$1"); shift ;;
  esac
done

mkdir -p "$INSTALL_DIR"

ver_of() {
  local f=$1
  [[ "$f" =~ Cursor-([0-9]+\.[0-9]+\.[0-9]+)-x86_64\.AppImage ]] && echo "${BASH_REMATCH[1]}"
}

list_appimages() {
  find "$INSTALL_DIR" -maxdepth 1 -name 'Cursor-*.AppImage' -type f 2>/dev/null | sort -V
}

latest_appimage() {
  local all
  mapfile -t all < <(list_appimages)
  [[ ${#all[@]} -gt 0 ]] && echo "${all[-1]}"
}

appimage_for() {
  local v=$1 p="$INSTALL_DIR/Cursor-${1}-x86_64.AppImage"
  [[ -f "$p" ]] && echo "$p"
}

launch() {
  local app=$1; shift
  [[ -x "$app" ]] || chmod +x "$app" 2>/dev/null || true
  if [[ "$VERBOSE" -eq 1 ]]; then
    log "launching $app (verbose)"
    exec "$app" "$@"
  else
    nohup "$app" "$@" >/dev/null 2>&1 < /dev/null &
    disown 2>/dev/null || true
  fi
}

need_cmd() { command -v "$1" >/dev/null 2>&1 || die "missing command: $1"; }

prune_old() {
  local all
  mapfile -t all < <(list_appimages)
  local total=${#all[@]}
  if (( total > KEEP )); then
    local i remove=$(( total - KEEP ))
    for (( i = 0; i < remove; i++ )); do
      log "pruning old version: $(ver_of "${all[i]}")"
      rm -f "${all[i]}"
    done
  fi
}

do_update() {
  need_cmd curl
  need_cmd jq

  local current
  current=$(latest_appimage || true)
  local local_ver=''
  [[ -n "$current" ]] && local_ver=$(ver_of "$current")
  log "local:  ${local_ver:-none}"

  local meta remote_ver download_url
  meta=$(curl -fsSL "$API_URL") || die "failed to fetch release metadata"
  remote_ver=$(jq -r '.version' <<<"$meta")
  download_url=$(jq -r '.downloadUrl' <<<"$meta")
  [[ -n "$remote_ver" && "$remote_ver" != null ]] || die "invalid API response (version)"
  [[ -n "$download_url" && "$download_url" != null ]] || die "invalid API response (downloadUrl)"
  log "remote: $remote_ver"

  if [[ "$local_ver" == "$remote_ver" && "$FORCE" -eq 0 ]]; then
    log "already up to date."
    prune_old
    return 0
  fi

  local dest="$INSTALL_DIR/Cursor-${remote_ver}-x86_64.AppImage"
  local tmp="${dest}.part.$$"
  log "downloading $remote_ver ..."
  curl -fL --progress-bar "$download_url" -o "$tmp"
  file "$tmp" | grep -q 'ELF 64-bit' || { rm -f "$tmp"; die "download is not a valid AppImage"; }
  chmod +x "$tmp"
  rm -f "$dest"
  mv "$tmp" "$dest"
  log "installed: $dest"
  prune_old
}

# --- dispatch ---------------------------------------------------------------

if [[ "$DO_UPDATE" -eq 1 ]]; then
  do_update
  exit 0
fi

if [[ "$SHOW_VERSION" -eq 1 && -z "$PICK_VERSION" ]]; then
  current=$(latest_appimage || true)
  current_ver=''
  [[ -n "$current" ]] && current_ver=$(ver_of "$current")
  if [[ -z "$current_ver" ]]; then
    log "no versions installed in $INSTALL_DIR (run: cursor --update)"
    exit 1
  fi
  printf 'Current: %s\n' "$current_ver"
  printf 'Available in %s:\n' "$INSTALL_DIR"
  while IFS= read -r f; do
    v=$(ver_of "$f")
    if [[ "$v" == "$current_ver" ]]; then
      printf '  %s  *\n' "$v"
    else
      printf '  %s\n' "$v"
    fi
  done < <(list_appimages | sort -rV)
  exit 0
fi

if [[ -n "$PICK_VERSION" ]]; then
  app=$(appimage_for "$PICK_VERSION" || true)
  if [[ -z "$app" ]]; then
    log "version $PICK_VERSION not found in $INSTALL_DIR"
    log "available: $(list_appimages | while IFS= read -r f; do ver_of "$f"; done | sort -rV | paste -sd' ' -)"
    exit 1
  fi
  launch "$app" "${PASSTHRU[@]}"
  exit 0
fi

# default: launch latest
app=$(latest_appimage || true)
[[ -n "$app" ]] || die "no Cursor installed in $INSTALL_DIR (run: cursor --update)"
launch "$app" "${PASSTHRU[@]}"
